{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist/",
    "e2e/"
  ],
  "overrides": [
    {
      "files": [
        "test/**"
      ],
      "rules": {
        "react/globals": "off",
        "react/immutability": "off"
      }
    },
    {
      "files": [
        "src/context/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
