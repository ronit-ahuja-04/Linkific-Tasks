{
  "name": "flowlane-context",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-flowlane \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-flowlane \"playwright test\"",
    "test:e2e:prod": "E2E_PROD=1 firebase emulators:exec --only auth,firestore --project demo-flowlane \"playwright test\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@reduxjs/toolkit": "^2.14.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
