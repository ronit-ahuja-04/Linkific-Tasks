{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // MIGRATION SETTINGS (M1 to M4): JavaScript files still exist and are not type-checked yet.
    // M5 turns allowJs off and adds noUncheckedIndexedAccess.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test"]
}
