# Copy to .env.local (or run `npm run env:local` with the local Supabase stack running).
# Public: inlined into the browser bundle at build time
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only: never sent to the browser
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MENTOR_INVITE_CODE=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional (Day 23): how long one database request may take before it counts as an outage (503). Default 5000.
# DB_TIMEOUT_MS=5000
# Database tests only
DATABASE_URL=
