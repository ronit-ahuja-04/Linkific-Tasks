# Day 24: caching rules for the static host (Netlify and Cloudflare Pages read this file; scripts/perf/common.mjs too).
#
# Files in /assets/ have a content hash in their name (index-CDf-UxAY.css): a new version is a new name, so a browser
# may keep them for a year without asking again. index.html is not hashed and names the current assets, so it must be
# checked on every visit, or a returning visitor could keep loading last week's app.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
