# Copy to .env (git-ignored). For the local stack, `npm run env:local` writes it for you.
# The anon key is public: security is enforced by Postgres Row Level Security.
# NEVER put the service_role / secret key or any AI API key in a VITE_ variable: those reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
