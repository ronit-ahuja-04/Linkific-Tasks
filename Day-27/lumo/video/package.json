{
  "name": "lumo-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lumo's lesson videos: a script becomes narration (local TTS), captions and an animated Remotion video.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "make": "node --experimental-websocket --no-warnings scripts/make-video.mjs",
    "demo": "node --no-warnings scripts/make-demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@remotion/bundler": "^4.0.547",
    "@remotion/cli": "^4.0.547",
    "@remotion/renderer": "^4.0.547",
    "@supabase/supabase-js": "^2.119.2",
    "kokoro-js": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.547"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.3",
    "typescript": "5.9"
  }
}
