# Copy to supabase/.env (git-ignored) and fill in ONLY if you turn Google or GitHub sign-in on in
# supabase/config.toml ([auth.external.github] / [auth.external.google], enabled = true).
# GitHub OAuth app callback URL for local development: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
