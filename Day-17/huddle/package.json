{
  "name": "huddle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "test:all": "npm test && npm run db:test && npm run test:e2e",
    "env:local": "node scripts/write-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.93.0",
    "supabase": "^3.2.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
