# FlowLane API: copy to server/.env and adjust. No secrets live here: the API holds no keys.
# (Verifying a Firebase ID token only needs Google's PUBLIC certificates.)

# Required. Your Firebase project id. In development it falls back to VITE_FIREBASE_PROJECT_ID
# from the client's ../.env when this is empty.
FIREBASE_PROJECT_ID=demo-flowlane

# Port for the API (the Vite dev server proxies /api to it).
PORT=4000

# Browser origin allowed to call the API directly (CORS). Through the Vite proxy it is not needed.
CLIENT_URL=http://localhost:5173

# GitHub REST API base URL. Point it at the local fake (npm run fake-github) for demos and e2e.
GITHUB_API_URL=https://api.github.com

# Firebase Auth emulator. When set AND NODE_ENV is not "production", the API accepts the emulator's
# UNSIGNED tokens (alg: none) after checking iss/aud/exp/sub. In production this is ignored.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199

# Requests per minute allowed for each signed-in user (uid).
RATE_LIMIT_MAX=60

NODE_ENV=development

# Set to true to silence request logs (tests do this).
# LOG_SILENT=true
